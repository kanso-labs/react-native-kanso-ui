{
  "name": "react-native-kanso-ui-example",
  "version": "0.0.0",
  "private": true,
  "description": "The on-device Storybook for react-native-kanso-ui, run in Expo Go from the story files in ../src",
  "main": "index.ts",
  "scripts": {
    "android": "npm run tokens && expo start --android",
    "export": "npm run tokens && expo export",
    "ios": "npm run tokens && expo start --ios",
    "start": "npm run tokens && expo start",
    "tokens": "npm --prefix .. run tokens:build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@storybook/react-native": "10.7.0",
    "expo": "57.0.28",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "storybook": "10.6.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  }
}
