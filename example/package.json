{
  "name": "react-native-kanso-ui-example",
  "version": "0.0.0",
  "private": true,
  "description": "The on-device Storybook for react-native-kanso-ui, run in Expo Go from the story files in ../src",
  "main": "index.ts",
  "scripts": {
    "android": "npm run tokens && expo start --android",
    "export": "npm run tokens && expo export",
    "ios": "npm run tokens && expo start --ios",
    "start": "npm run tokens && expo start",
    "tokens": "npm --prefix .. run tokens:build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@internationalized/date": "3.12.4",
    "@internationalized/number": "3.6.9",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@storybook/react-native": "10.7.0",
    "expo": "58.0.14",
    "expo-clipboard": "58.0.3",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "react-stately": "3.51.0",
    "storybook": "10.6.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
