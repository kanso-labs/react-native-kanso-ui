{
  "name": "react-native-kanso-ui-example",
  "version": "0.0.0",
  "private": true,
  "description": "The on-device Storybook for react-native-kanso-ui, run in Expo Go from the story files in ../src",
  "main": "index.ts",
  "scripts": {
    "android": "expo start --android --localhost",
    "export": "expo export",
    "ios": "expo start --ios",
    "postinstall": "patch-package",
    "start": "expo start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@internationalized/date": "3.12.4",
    "@internationalized/number": "3.6.9",
    "@kanso-labs/kanso-ui-core": "0.1.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@storybook/react-native": "10.7.1",
    "expo": "58.0.23",
    "expo-clipboard": "58.0.4",
    "expo-document-picker": "58.0.4",
    "expo-image-picker": "58.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "react-stately": "3.51.0",
    "storybook": "10.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "patch-package": "8.0.1",
    "typescript": "6.0.3"
  }
}
