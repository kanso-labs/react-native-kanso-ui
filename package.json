{
  "name": "@kanso-labs/react-native-kanso-ui",
  "version": "0.0.0",
  "description": "Kanso UI's Material Design components for React Native, themed through the same --kui-* design tokens as the web library",
  "keywords": [
    "react-native",
    "expo",
    "material-design",
    "design-system",
    "design-tokens",
    "components"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanso-labs/react-native-kanso-ui.git"
  },
  "scripts": {
    "build": "npm run tokens:build && tsc -b && tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "npm run tokens:build && oxlint --type-aware . && eslint . && npm run format:check",
    "package:check": "publint && attw --pack --profile esm-only",
    "prepare": "husky || true",
    "test": "npm run tokens:build && jest",
    "test:coverage": "npm run tokens:build && jest --coverage",
    "tokens:build": "node scripts/build-tokens.mjs"
  },
  "author": "Kanso Labs <kanso.labs.org@gmail.com>",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "7.29.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@jest/globals": "29.7.0",
    "@kanso-labs/kanso-ui": "0.43.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-oxlint": "1.87.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "style-dictionary": "5.6.1",
    "test-renderer": "1.3.1",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-native": ">=0.86.0",
    "react-native-safe-area-context": "^5.0.0"
  },
  "overrides": {
    "eslint-plugin-oxlint": {
      "oxlint": "$oxlint"
    }
  }
}
