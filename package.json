{
  "name": "@kanso-labs/react-native-kanso-ui",
  "version": "0.11.3",
  "description": "Kanso UI's Material Design components for React Native, themed through the same --kui-* design tokens as the web library",
  "keywords": [
    "react-native",
    "expo",
    "material-design",
    "design-system",
    "design-tokens",
    "components"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanso-labs/react-native-kanso-ui.git"
  },
  "scripts": {
    "build": "npm run tokens:build && tsc -b && tsdown",
    "build-storybook": "storybook build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "npm run tokens:build && oxlint --type-aware . && eslint . && npm run format:check",
    "package:check": "publint && attw --pack --profile esm-only",
    "prepare": "husky || true",
    "storybook": "storybook dev -p ${PORT:-6006}",
    "test": "npm run tokens:build && jest",
    "test:coverage": "npm run tokens:build && jest --coverage",
    "test:storybook": "vitest run --mode development",
    "tokens:build": "node scripts/build-tokens.mjs"
  },
  "author": "Kanso Labs <kanso.labs.org@gmail.com>",
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@internationalized/number": "3.6.9",
    "react-stately": "3.51.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-dynamic-import": "7.29.7",
    "@codecov/rollup-plugin": "2.0.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@jest/globals": "29.7.0",
    "@kanso-labs/kanso-ui": "0.44.0",
    "@kanso-labs/unplugin-style-dictionary": "0.10.36",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react": "10.6.3",
    "@storybook/react-native-web-vite": "10.6.3",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-oxlint": "1.89.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-junit": "17.0.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "storybook": "10.6.3",
    "style-dictionary": "5.7.0",
    "test-renderer": "1.3.1",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "expo-clipboard": ">=57.0.0",
    "expo-document-picker": ">=57.0.0",
    "expo-font": ">=57.0.0",
    "expo-image-picker": ">=57.0.0",
    "react": ">=19.2.0",
    "react-native": ">=0.86.0",
    "react-native-gesture-handler": "^2.32.0 || ^3.0.0",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-svg": "^15.15.0",
    "react-native-worklets": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "expo-clipboard": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "expo-font": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    }
  },
  "overrides": {
    "eslint-plugin-oxlint": {
      "oxlint": "$oxlint"
    }
  }
}
